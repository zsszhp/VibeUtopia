# VibeUtopia 环境配置
# 复制此文件为 .env 并填入真实值: cp .env.example .env

# ==================== LLM 厂商配置 (快捷切换) ====================
# 填入你有的 key，没有的留空。
# 你可以直接在此粘贴厂商的 Base URL 和模型名字，系统会优先使用 .env 中的设置。
#
# 多 Key 智能调度：每个厂商支持配置多个 Key，用逗号分隔（如 "key1,key2,key3"）。
# 调度策略：当前 Key 配额耗尽 → 自动切换同厂商下一个 Key → 同厂商全部耗尽 → 自动切换其他厂商。
# 整个过程对用户完全透明，无需手动干预。

# --- LongCat (支持快捷粘贴) ---
# 多 Key 支持：用逗号分隔多个 Key，如 "key1,key2,key3"
# 系统会自动按顺序使用，当前 Key 配额耗尽时自动切换到下一个
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
LONGCAT_MODEL=LongCat-Flash-Thinking-2601

# --- DeepSeek (官方) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- 阿里通义 (支持多模态+ 音频转写) ---
ALIYUN_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_MODEL=qwen-max

# --- 硅基流动 ---
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# --- 智谱 AI ---
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4

# --- 智谱 AI (视觉模型) ---
ZHIPU_VL_MODEL=glm-4v

# --- 商汤 SenseNova (DeepSeek V4 Flash) ---
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_MODEL=deepseek-v4-flash

# ==================== 模型路由控制 ====================
# DEFAULT_PROVIDER 指定当前激活的厂商 (longcat / deepseek / aliyun / siliconflow / sensenova)
DEFAULT_PROVIDER=longcat

# DEFAULT_MODEL 如果指定，则强制使用该模型；如果留空，则使用上面各厂商配置里的模型
DEFAULT_MODEL=

# ==================== 数据库 ====================
# MySQL (默认通过 Docker Compose 启动)
DATABASE_URL=mysql+pymysql://vibe_user:vibe_password@localhost:3306/vibeutopia

# SQLite 降级 (无 Docker 时取消注释以下行)
# DATABASE_URL=sqlite:///./data/vibeutopia.db

# ChromaDB 向量存储路径
CHROMA_DB_PATH=./data/chroma

# ==================== Neo4j 知识图谱 ====================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vibeutopia2024

# ==================== 仿真引擎 & 风控 ====================
AGENTS_PER_PLATFORM=10
MEMORY_RETRIEVAL_LIMIT=5
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
