# 复制此文件为 .env 并填入真实的 API Key
# Copy this file to .env and fill in your real API keys

# === LLM Provider API Keys ===
# 填入你有的 key，没有的留空即可，系统会自动跳过

# DeepSeek / LongCat (通过LongCat中转)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.longcat.chat/openai/v1
DEEPSEEK_MODEL=LongCat-Flash-Lite

# LongCat
LONGCAT_API_KEY=

# 阿里通义 (用于OCR/Paraformer等)
ALIYUN_API_KEY=

# 硅基流动 (用于本地模型推理)
SILICONFLOW_API_KEY=

# === 模型路由配置 ===
# 默认 provider（留空则按 tier 自动选择第一个有 key 的）
# DEFAULT_PROVIDER=longcat
# 默认模型（留空则按 tier 自动选择）
# DEFAULT_MODEL=LongCat-Flash-Lite
# 模型冷却时间（秒），默认 300
# MODEL_COOLDOWN_SECONDS=300

# === 数据库配置 ===
# 默认本地 SQLite，无需修改
# DATABASE_URL=sqlite:///./data/vibeutopia.db

# MySQL（多用户/高并发场景，留空则用SQLite）
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=vibeutopia

# === Neo4j 知识图谱 ===
# Lite模式可跳过，图谱功能不可用时不影响核心风控
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=vibeutopia2024

# === 信号采集 ===
# SIGNAL_DEFAULT_MODE=standard

# === 人格工厂 ===
# AGENTS_PER_PLATFORM=5
# PERSONA_MAX_CONCURRENT=5

# === 多模态风控 ===
# KEYFRAME_MAX_FRAMES=50
# KEYFRAME_INTERVAL_SECONDS=5.0
# OCR_MIN_CONFIDENCE=0.5
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu

# === LLM 超时 ===
# LLM_TIMEOUT=30
# LLM_MAX_RETRIES=1
