    {
      "start": 413.04,
      "end": 415.84,
      "text": "交损室说听音频交叉处理模块"
    },
    {
      "start": 415.84,
      "end": 418.64,
      "text": "最终得到一个171的残数模型"
    },
    {
      "start": 418.64,
      "end": 421.44,
      "text": "并在数千万的视频片段上版程训练"
    },
    {
      "start": 421.44,
      "end": 423.44,
      "text": "这就是被slpm"
    },
    {
      "start": 423.44,
      "end": 426.64,
      "text": "被slpm已经可以声称高是两可控的"
    },
    {
      "start": 426.64,
      "end": 427.64,
      "text": "角色表案视频"
    },
    {
      "start": 427.64,
      "end": 430.44,
      "text": "并具备以分钟为单位的持续移植性"
