    {
      "start": 406.84,
      "end": 408.84,
      "text": "预讯练图升视频基础模型"
    },
    {
      "start": 408.84,
      "end": 409.84,
      "text": "在这个底座上"
    },
    {
      "start": 409.84,
      "end": 411.64,
      "text": "在额外引入31残数"
