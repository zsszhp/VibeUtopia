    {
      "start": 515.04,
      "end": 516.04,
      "text": "阿斯迪"
    },
    {
      "start": 517.04,
      "end": 518.64,
      "text": "你这两天干嘛去了"
    },
    {
      "start": 518.64,
      "end": 519.64,
      "text": "我又问第三遍了"
