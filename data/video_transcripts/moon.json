      "text": "唐天"
    },
    {
      "start": 1064.32,
      "end": 1066.32,
      "text": "注定是一場被祖授的惡夢"
    },
    {
      "start": 1066.32,
      "end": 1068.32,
      "text": "火箭在人類的暴行中悲劇的誕生"
    },
    {
      "start": 1069.32,
      "end": 1071.32,
      "text": "1942年10月"
    },
    {
      "start": 1071.32,
      "end": 1073.32,
      "text": "Wirth火箭第一次試試成功"
    },
    {
      "start": 1073.32,
      "end": 1075.32,
      "text": "證明現代火箭的筆祖"
    },
    {
      "start": 1075.32,
      "end": 1077.32,
      "text": "是納粹企圖改變戰局的暴復性武器"
    },
    {
      "start": 1077.32,
      "end": 1079.32,
      "text": "占滿先學的科技之下"
    },
    {
      "start": 1079.32,
      "end": 1081.32,
      "text": "是集中贏2萬倍越大而死的神秘"
    },
    {
      "start": 1081.32,
      "end": 1082.32,
      "text": "二戰結束後"
    },
    {
      "start": 1082.32,
      "end": 1084.32,
      "text": "美國發動回新真計劃"
    },
    {
      "start": 1084.32,
      "end": 1087.32,
      "text": "將納粹的核心技術團隊打包帶走"
    },
    {
      "start": 1087.32,
      "end": 1089.32,
      "text": "大量一滿納粹土表的Wirth火箭成品"
    },
    {
      "start": 1089.32,
      "end": 1090.32,
      "text": "被新挑起包裹"
    },
    {
      "start": 1090.32,
      "end": 1092.32,
      "text": "運往了向往和平的過度"
    },
    {
      "start": 1092.32,
      "end": 1093.32,
      "text": "而蘇聯直接佔領了"
    },
    {
      "start": 1093.32,
      "end": 1095.32,
      "text": "佩雷明的研發基地"
    },
    {
      "start": 1095.32,
      "end": 1096.32,
      "text": "通過逆向工程"
    },
    {
      "start": 1096.32,
      "end": 1097.32,
      "text": "反制出了 R1火箭"
    },
    {
      "start": 1097.32,
      "end": 1099.32,
      "text": "最終將人類的1顆人造衛星"
    },
    {
      "start": 1099.32,
      "end": 1100.32,
      "text": "送入太空"
    },
    {
      "start": 1100.32,
      "end": 1102.32,
      "text": "美蘇想要控制太空"
    },
    {
      "start": 1102.32,
      "end": 1104.32,
      "text": "就像16世紀的帝國"
    },
    {
      "start": 1104.32,
      "end": 1105.32,
      "text": "想要統治海洋"
    },
    {
      "start": 1105.32,
      "end": 1107.32,
      "text": "納粹的許多核心部門領導"
    },
    {
      "start": 1107.32,
      "end": 1108.32,
