    {
      "start": 1129.32,
      "end": 1131.32,
      "text": "會一直耐心的見證"
    },
    {
      "start": 1131.32,
      "end": 1133.32,
      "text": "人類對於沉弱的旅行"
    },
    {
      "start": 1134.32,
      "end": 1135.32,
      "text": "1977年"
    },
    {
      "start": 1135.32,
      "end": 1137.32,
      "text": "旅行者1號從地球出發"
    },
    {
      "start": 1137.32,
      "end": 1139.32,
      "text": "她是人類最遙遠的使者"
    },
    {
      "start": 1139.32,
      "end": 1141.32,
      "text": "逃離這顆被反復柔令的星球"
    },
    {
      "start": 1141.32,
      "end": 1143.32,
      "text": "走向迎合身處"
    },
    {
      "start": 1143.32,
      "end": 1145.32,
      "text": "她攜帶了一張肚金唱片"
    },
    {
      "start": 1145.32,
      "end": 1146.32,
      "text": "音樂之外"
    },
    {
      "start": 1146.32,
      "end": 1148.32,
      "text": "她收錄了地球的風聲"
    },
    {
      "start": 1148.32,
      "end": 1149.32,
      "text": "人類的行跳"
    },
    {
      "start": 1149.32,
      "end": 1151.32,
      "text": "愛人的親吻"
    },
    {
      "start": 1151.32,
      "end": 1153.32,
      "text": "1955種語言的問號"
    },
    {
      "start": 1153.32,
      "end": 1154.32,
      "text": "上面沒有意識形態"
    },
    {
      "start": 1154.32,
      "end": 1155.32,
      "text": "沒有呼救"
    },
    {
      "start": 1155.32,
      "end": 1156.32,
      "text": "沒有戰爭"
    },
    {
      "start": 1156.32,
      "end": 1157.32,
      "text": "也許人類意識到"
