      "text": "看守著藏於未知的希望"
    },
    {
      "start": 1016.32,
      "end": 1019.32,
      "text": "與周溫柔的注視著人類的黃虎"
    },
    {
      "start": 1019.32,
      "end": 1021.32,
      "text": "等待著他們自己來回答"
    },
    {
      "start": 1021.32,
      "end": 1022.32,
      "text": "星空之下"
    },
    {
      "start": 1022.32,
      "end": 1025.32,
      "text": "種椎國籍的差異逐漸銷容"
    },
    {
      "start": 1025.32,
      "end": 1027.32,
      "text": "不同的膚色在同一個實驗室裏工作"
    },
    {
      "start": 1027.32,
      "end": 1029.32,
      "text": "世界各地的測控戰"
    },
    {
      "start": 1029.32,
      "end": 1031.32,
      "text": "共同保障著阿波羅11號的通訊"
    },
    {
      "start": 1031.32,
      "end": 1034.32,
      "text": "來自73個國家的領導人的和平紀於"
    },
    {
      "start": 1034.32,
      "end": 1036.32,
      "text": "被留在了月球"
    },
    {
      "start": 1036.32,
      "end": 1037.32,
      "text": "1969年7月"
    },
    {
      "start": 1037.32,
      "end": 1039.32,
      "text": "人類在月球留下了一塊牌筆"
    },
    {
      "start": 1039.32,
      "end": 1041.32,
      "text": "在語言浩漢無邊的表達中"
    },
    {
      "start": 1041.32,
      "end": 1043.32,
      "text": "我們只留下了一句"
    },
    {
      "start": 1045.32,
      "end": 1047.32,
      "text": "來自行星地球的人類"
    },
    {
      "start": 1047.32,
      "end": 1048.32,
      "text": "首次踏上月球"
    },
    {
      "start": 1048.32,
      "end": 1051.32,
      "text": "我們未全人類的和平而來"
    },
    {
      "start": 1063.32,
