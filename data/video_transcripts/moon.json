    },
    {
      "start": 1112.32,
      "end": 1113.32,
      "text": "共向同一顆心災"
    },
    {
      "start": 1113.32,
      "end": 1115.32,
      "text": "人類的太空探索"
    },
    {
      "start": 1115.32,
      "end": 1116.32,
      "text": "成為了冷戰的銀序"
    },
    {
      "start": 1116.32,
      "end": 1118.32,
      "text": "我們用毀滅世紀的武器"
    },
    {
      "start": 1118.32,
