    {
      "start": 1163.32,
      "end": 1165.32,
      "text": "敲敲的告訴宇宙"
    },
    {
      "start": 1165.32,
      "end": 1167.32,
      "text": "這裡風吹柔和"
    },
    {
      "start": 1167.32,
      "end": 1168.32,
      "text": "我們曾經來過"
    },
    {
      "start": 1171.32,
      "end": 1172.32,
      "text": "這就是這些視頻的"
    },
    {
      "start": 1172.32,
      "end": 1173.32,
      "text": "全部內容了"
    },
    {
      "start": 1173.32,
      "end": 1174.32,
      "text": "馬上就大大三了"
    },
    {
      "start": 1174.32,
      "end": 1175.32,
      "text": "趕著做視頻的時間和機會"
    },
    {
      "start": 1175.32,
      "end": 1176.32,
      "text": "呼籲越來越少"
    },
    {
      "start": 1176.32,
      "end": 1177.32,
      "text": "所以每一次碰到一個"
    },
    {
      "start": 1177.32,
      "end": 1178.32,
      "text": "很好好的選題都會花"
    },
    {
      "start": 1178.32,
      "end": 1179.32,
      "text": "很長很長的時間"
    },
    {
      "start": 1179.32,
      "end": 1180.32,
      "text": "把它做得自己滿意為止"
    },
    {
      "start": 1180.32,
      "end": 1181.32,
      "text": "所以如果你喜歡這些視頻的話"
    },
    {
      "start": 1181.32,
      "end": 1183.32,
      "text": "就給我一個點在和關注"
    },
    {
      "start": 1183.32,
      "end": 1184.32,
      "text": "覺得我們來說是"
    },
    {
      "start": 1184.32,
      "end": 1185.32,
      "text": "非常非常大的鼓勵"
    },
    {
      "start": 1185.32,
      "end": 1186.32,
      "text": "謝謝你"
    }
